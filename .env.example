# Скопируйте этот файл в .env и заполните значения.
# Файл .env в репозиторий не попадает (см. .gitignore).

# База данных. Пароль — только латинские буквы и цифры.
POSTGRES_DB=quietfriend
POSTGRES_USER=quietfriend
POSTGRES_PASSWORD=

# Firebase
FIREBASE_PROJECT_ID=quiet-friend-452d6
# Полный путь к ключу сервисного аккаунта на вашем компьютере
FIREBASE_ADMIN_KEY_PATH=/Users/ВАШ_ПОЛЬЗОВАТЕЛЬ/Documents/quiet-friend-secrets/firebase-admin-key.json

# Минимальная поддерживаемая версия приложения
MIN_APP_VERSION=1.0.0

LOG_LEVEL=INFO
